{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "OPENROUTER_API_KEY",
    "OPENROUTER_MODEL",
    "V0_API_KEY",
    "V0_CLONE_ORIGIN",
    "V0_PREVIEW_PROXY_URL",
    "VERCEL",
    "VERCEL_ENV",
    "VERCEL_RELATED_PROJECTS"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    }
  }
}
